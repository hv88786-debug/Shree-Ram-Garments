{
  "name": "shree-ram-garments-site",
  "version": "1.0.0",
  "private": true,
  "description": "Shree Ram Garments static website (Tailwind compiled at build time)",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i src/input.css -o assets/styles.css --minify",
    "build": "node build.mjs",
    "dev:css": "tailwindcss -c tailwind.config.js -i src/input.css -o assets/styles.css --watch"
  },
  "devDependencies": {
    "tailwindcss": "3.4.17"
  }
}
